{
  "name": "nb-books",
  "version": "1.0.0",
  "description": "Plataforma de lectura, gestión documental y aprendizaje digital",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nb-digital-hq/nb-books.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "empaquetar:linux": "node scripts/empaquetar-linux.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
    "lint": "biome check . && prettier --check \"**/*.{svelte,css}\"",
    "lint:fix": "biome check --write . && prettier --write \"**/*.{svelte,css}\"",
    "format": "biome format --write . && prettier --write \"**/*.{svelte,css}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm test:e2e && pnpm check:webkitgtk && pnpm check:paquete && pnpm check:ui && pnpm check:i18n && pnpm check:docs && pnpm check:errors && pnpm check:registro && pnpm check:rutas && pnpm check:network && pnpm check:bindings && pnpm check:paletas && pnpm check:puente && pnpm check:comandos && pnpm check:listas && pnpm check:transacciones && pnpm check:plataforma && pnpm check:permisos && pnpm check:forzados && pnpm check:esquema && pnpm check:capacidades && pnpm check:politica && pnpm check:evaluacion && pnpm check:notices",
    "prepare": "git config core.hooksPath .githooks",
    "check:webkitgtk": "python3 scripts/recorrido-webkitgtk.py",
    "check:docs": "node scripts/check-docs.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:network": "node scripts/check-network.mjs",
    "check:registro": "node scripts/check-registro.mjs",
    "check:rutas": "node scripts/check-rutas.mjs",
    "check:bindings": "node scripts/check-bindings.mjs",
    "check:puente": "node scripts/check-puente.mjs",
    "check:comandos": "node scripts/check-comandos.mjs",
    "check:listas": "node scripts/check-listas.mjs",
    "check:transacciones": "node scripts/check-transacciones.mjs",
    "check:errors": "node scripts/check-error-contract.mjs",
    "check:notices": "node scripts/generate-notices.mjs --check",
    "pdfium": "node scripts/fetch-pdfium.mjs",
    "instalar:local": "node scripts/instalar-local.mjs",
    "procedencia": "node scripts/procedencia.mjs",
    "check:pdfium": "node scripts/fetch-pdfium.mjs --check",
    "notices": "node scripts/generate-notices.mjs",
    "baseline": "node scripts/measure-baseline.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:capacidades": "node scripts/check-capacidades.mjs",
    "check:esquema": "node scripts/check-esquema.mjs",
    "check:plataforma": "node scripts/check-plataforma.mjs",
    "check:permisos": "node scripts/check-permisos.mjs",
    "check:forzados": "node scripts/check-forzados.mjs",
    "check:politica": "node scripts/check-politica.mjs",
    "check:evaluacion": "node scripts/check-evaluacion.mjs",
    "check:avisos": "node scripts/check-avisos.mjs",
    "check:paletas": "node scripts/generar-paletas.mjs --check",
    "check:paquete": "node scripts/check-paquete.mjs",
    "extensiones:empaquetar": "node scripts/empaquetar-extensiones.mjs",
    "paletas": "node scripts/generar-paletas.mjs"
  },
  "dependencies": {
    "@ktibow/material-color-utilities-nightly": "0.4.01772748028000",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "m3-svelte": "^7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.1",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
